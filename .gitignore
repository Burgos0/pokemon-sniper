__pycache__/
*.pyc
.venv/

# Databases are persisted via verified GitHub Release snapshots, not
# ordinary commits (see scripts/snapshot_storage.py).
data/*.db
data/*.db.bak.*
data/backfill_report.json

# Every downloaded TCGCSV archive is kept here and never re-downloaded.
data/archive_cache/

# Built static site (generated in CI); only its data file is committed daily.
site/*
!site/dashboard.json
data/*.log
data/backtest_report*
